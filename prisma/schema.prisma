generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemePreference {
  LIGHT
  DARK
  AUTO
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

model UserMeta {
  id      String @id @default(cuid())
  clerkId String @unique

  events                    Event[]
  habits                    Habit[]
  dates                     Date[]
  googleCalendarIntegration GoogleCalendarIntegration?

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?
}

model Date {
  id   String   @id @default(cuid())
  date DateTime @unique

  userMetaId String
  userMeta   UserMeta @relation(fields: [userMetaId], references: [id])

  events Event[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  @@index([userMetaId])
}

model Event {
  id     String @id @default(cuid())
  dateId String
  date   Date   @relation(fields: [dateId], references: [id])

  userMetaId String
  userMeta   UserMeta @relation(fields: [userMetaId], references: [id])

  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  @@index([dateId])
  @@index([userMetaId])
  @@index([habitId])
}

model Habit {
  id          String         @id @default(cuid())
  name        String
  description String?
  frequency   HabitFrequency
  customDays  Int[]          @default([])

  userMetaId String
  userMeta   UserMeta @relation(fields: [userMetaId], references: [id])

  events Event[]

  reminderEnabled Boolean   @default(false)
  reminderTime    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userMetaId])
}

model GoogleCalendarIntegration {
  id           String    @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  calendarId   String?
  lastSyncedAt DateTime?

  userMetaId String   @unique
  userMeta   UserMeta @relation(fields: [userMetaId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userMetaId])
}

// CRM Models
model Contact {
  id             String            @id @default(cuid())
  userId         String // Foreign key to User
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  socialLinks    Json? // Stores social media profile links
  notes          String? // Free-text field for additional details
  category       ContactCategory
  customCategory String? // For user-defined categories
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reminders      ReminderContact[]
  eventTags      EventTag[]

  @@unique([userId, email])
  @@index([userId])
}

enum ReminderPriority {
  LOW
  MEDIUM
  HIGH
}

model Reminder {
  id          String             @id @default(cuid())
  userId      String // Foreign key to User
  title       String
  description String?
  dueDate     DateTime
  isRecurring Boolean            @default(false)
  frequency   ReminderFrequency?
  status      ReminderStatus
  priority    ReminderPriority   @default(MEDIUM)
  tags        String[]           @default([])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  contacts    ReminderContact[]

  @@index([userId])
}

model EventTag {
  id        String   @id @default(cuid())
  contactId String
  userId    String
  eventId   String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([contactId])
  @@index([eventId])
}

enum ContactCategory {
  FAMILY
  FRIENDS
  COLLEAGUES
  CLIENTS
  OTHERS
}

enum ReminderFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ReminderStatus {
  PENDING
  COMPLETED
  SNOOZED
}

model ReminderContact {
  id         String   @id @default(cuid())
  reminderId String
  contactId  String
  userId     String
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([reminderId, contactId])
  @@index([userId])
  @@index([reminderId])
  @@index([contactId])
}
