generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemePreference {
  LIGHT
  DARK
  AUTO
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

model UserMeta {
  id      String @id @default(cuid())
  clerkId String @unique

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  deletedAt DateTime?
  Event     Event[]
  Habit     Habit[]
}

model Date {
  id   String   @id @default(cuid())
  date DateTime

  events Event[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?
}

model Event {
  id     String @id @default(cuid())
  dateId String
  date   Date   @relation(fields: [dateId], references: [id])

  userMetaId String
  userMeta   UserMeta @relation(fields: [userMetaId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?
}

model Habit {
  id          String         @id @default(cuid())
  name        String
  description String?
  frequency   HabitFrequency
  customDays  Int[]          @default([])

  userMetaId String
  userMeta   UserMeta @relation(fields: [userMetaId], references: [id])

  reminderEnabled Boolean   @default(false)
  reminderTime    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userMetaId])
}
